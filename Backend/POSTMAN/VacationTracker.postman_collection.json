								{ "key": "price", "value": "1500", "type": "text" },
								{ "key": "image", "type": "file", "src": "/C:/Users/tomer/OneDrive/Desktop/Projects/VacationTracker/Backend/src/assets/images/59b3cc24-0988-4dfd-8d94-5f34b8d17c54.jpg" }
