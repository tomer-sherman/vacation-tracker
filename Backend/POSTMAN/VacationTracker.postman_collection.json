						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user1@gmail.com\",\n    \"password\": \"123Abc\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "login"]
						}
					}
				},
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code < 300) pm.collectionVariables.set(\"token\", pm.response.json());"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"tomersherman@gmail.com\",\n    \"password\": \"123Abc\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Vacations",
			"item": [
				{
					"name": "Get All Vacations",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/vacations",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vacations"]
						}
					}
				},
				{
					"name": "Get One Vacation",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/vacations/:_id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vacations", ":_id"],
							"variable": [{ "key": "_id", "value": "6ace3cab487827bff8d777a1" }]
						}
					}
				},
				{
					"name": "Like Vacation",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/vacations/like/:_id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vacations", "like", ":_id"],
							"variable": [{ "key": "_id", "value": "6ace3cab487827bff8d777a1" }]
						}
					}
				},
				{
					"name": "Unlike Vacation",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/vacations/unlike/:_id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vacations", "unlike", ":_id"],
							"variable": [{ "key": "_id", "value": "6ace3cab487827bff8d777a1" }]
						}
					}
				},
				{
