					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/images/:imageId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "images", ":imageId"],
							"variable": [{ "key": "imageId", "value": "39eb5b69-9eac-46fb-a0e9-1e7dd1abb331.jpg" }]
						}
					}
				}
			]
		},
