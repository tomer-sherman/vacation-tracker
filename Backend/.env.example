# Copy this file to .env and fill in your own values.

# Enviorment
ENVIRONMENT = "development"

# Db connection - used when running locally.
# In docker, compose.yml overrides it with mongodb://mongo-service:27017/vacation-tracker
MONGO_CONNECTION_STRING = "mongodb://localhost:27017/vacation-tracker"

# Security
JWT_SECRET = "your-jwt-secret"

# Must match the salt the seed users' passwords were hashed with, otherwise the seeded accounts can't log in:
HASH_SALT = "your-hash-salt"

# Currently unused:
RECAPTCHA_SECRET_KEY = "your-recaptcha-secret-key"

# Keys
OPENAI_API_KEY = "your-openai-api-key"

# Ngrok url - the public url OpenAI uses to reach the MCP server:
NGROK_URL = "https://your-subdomain.ngrok-free.dev"
